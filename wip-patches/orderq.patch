+            }
+            if (!ClearFor(x, y, ignoreA, ignoreB)) return LosBlock.Obstacle;
+            if (passedHigh) return LosBlock.High;
+            int i = y * Width + x;
+            if ((x != ex || y != ey) && forestDepth[i] > seeDepth) return LosBlock.Forest;
