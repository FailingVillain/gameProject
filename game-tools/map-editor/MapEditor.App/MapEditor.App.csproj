<Project Sdk="Microsoft.NET.Sdk">
  <!-- T33b: map editor window (Raylib). Separate tool; the game csproj is a read-only reference (renderer/theme/fonts are reused, not copied). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MapEditor.App</RootNamespace>
    <AssemblyName>MapEditor</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StartupObject>MapEditor.App.EditorMain</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MapEditor.Model\MapEditor.Model.csproj" />
    <ProjectReference Include="..\..\..\korean-division\KoreanDivision.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="scripts\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- font atlas: copy this tool's sources (and the game files whose messages show in the status bar) so every Korean glyph in them is loaded (Editor.AllText) -->
    <None Include="*.cs" Link="srcmirror\app\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\MapEditor.Model\*.cs" Link="srcmirror\model\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\korean-division\src\Core\MapFile.cs" Link="srcmirror\game\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\korean-division\src\Core\Mission\MissionDef.cs" Link="srcmirror\game\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
