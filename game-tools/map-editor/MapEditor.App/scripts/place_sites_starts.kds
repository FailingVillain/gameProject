# 시설 · 시작 · 유닛 (지도 파일의 sites / starts / units). 클릭 = 놓기, 우클릭 = 지우기, 시작은 끌어서 옮김.
new 64 64
assert starts=2 sites=0 units=0
button tool_site
pick village
assert tool=site site_sel=village owner=1
button own_inc
assert owner=2
button own_dec
button own_dec
button own_dec
assert owner=0
click 30 30
assert sites=1 site(0)=village@30,30,0 errors=0
button own_inc
click 40 30
assert site(1)=village@40,30,1
button type_next
button type_prev
click 40 30                      # 같은 시설 같은 자리 = 놓지 않음
assert sites=2
click 41 31                      # 몸체가 겹침 -> 경고 (오류 아님)
assert sites=3 warnings>=1 errors=0
rclick 41 31
assert sites=2
rclick 30 30
assert sites=1 site(0)=village@40,30,1
key ctrl+z
assert sites=2
# 시작 위치
button tool_start
assert tool=start
click 20 50
assert starts=3 start(2)=20,50
drag 20 50 25 52                 # 끌어서 옮김 (미리보기는 끄는 동안, 확정은 뗄 때)
assert starts=3 start(2)=25,52
rclick 25 52
assert starts=2
rclick 8 32                      # 최소 2개: 지워지지 않는다
rclick 56 32
assert starts=2
key ctrl+z                       # 지움 되돌림
assert starts=3 start(2)=25,52
key ctrl+z                       # 옮김 되돌림
assert starts=3 start(2)=20,50
key ctrl+z                       # 추가 되돌림
assert starts=2 start(0)=8,32
click 70 70                      # 지도 밖: 무시
assert starts=2
# 유닛
button tool_unit
pick infantry
assert tool=unit unit_sel=infantry
button own_dec
button own_dec
button own_inc
button count_inc
button count_inc
assert count=3
button count_dec
assert count=2
click 30 20
assert units=1 unit(0)=infantry@30.5,20.5,2,2 errors=0
button type_next
click 34 20
assert units=2
rclick 30 20
assert units=1
key ctrl+z
assert units=2
key u
assert tool=unit
key t
assert tool=start
key s
assert tool=site
zoom 0.6
center 32 32
shot sites_starts.png
expect 5F3E99C7B6F683A2
