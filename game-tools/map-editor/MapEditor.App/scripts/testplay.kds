# 테스트 실행 F5: 저장 -> 게임이 읽는 폴더의 임시 사본 -> --map / --mission --mission-start 인자 (스크립트에서는 창을 띄우지 않고 인자만 기록).
new 64 64
tool rect
terrain water
drag 20 20 25 25
button testplay
assert launch=--map+_editor_test dirty=0
open c0_02_yalu
tool prop
pick rock_l
click 100 140
assert props=1 dirty=1
# 오류가 있으면 실행하지 않는다 (기록된 인자가 이전 그대로)
tool rect
terrain water
drag 118 148 122 152             # 시작 1 이 물 위
assert errors>=1
button testplay
assert launch=--map+_editor_test dirty=1
zoom 0.5
center 120 150
shot testplay_blocked.png
key ctrl+z
assert errors=0
key f5
assert launch=--mission+_editor_test+--mission-start dirty=0
shot testplay.png
