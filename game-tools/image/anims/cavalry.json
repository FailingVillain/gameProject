    "gallop":  {"frames": ["gallop_1", "gallop_2", "gallop_3", "gallop_4"], "ms": 95, "shared_fit": true},
    "fire":    {"frames": ["aim", "fire"], "ms": [450, 160], "shared_fit": true},
    "charge":  {"frames": ["charge_1", "charge_2", "charge_3", "charge_4"], "ms": 95, "shared_fit": true},
    "melee":   {"frames": ["melee_1", "melee_2", "melee_3"], "ms": [240, 140, 260], "shared_fit": true},
    "death":   {"frames": ["hit", "fall", "dead"], "ms": [250, 300, 1200], "shared_fit": true},
    "death_b": {"frames": ["hit_b", "slip_b", "fall_b", "dead_b"], "ms": [200, 350, 300, 1200], "shared_fit": true}
