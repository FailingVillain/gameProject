  // 참호 돌격 교리 (N32, 사용자 승인 2026-10-20, src/Core/TrenchAssault.cs, docs/ENGINE_NOTES.md '참호 돌격'). 밸런스 수치 아님 — 순서 · 판단. 칸 = 지도 칸.
  // 1 제압: farDist 칸 밖이면 집결, 경기관총은 사거리 × gunStandFrac 사격 진지, prepMin~prepMaxSec 동안 방어병 (suppRadius 안 보이는) 엎드림 · 고정 · 제압 ≥ suppGoal 비율 ≥ suppFrac 이면 다음. 포병은 지점 포격 (useGroundFire; 전술 AI 는 aiGroundFire).
  // 2 접근: 분대 교대 약진 (boundLength, boundMaxSec) 참호까지 boundEndDist 칸이면 속보 돌진 (사양 "~30칸" 은 소총 사거리 24 밖이라 약진이 아무 의미 없고 돌진이 사격 구역 전체 25칸이 됨 — 측정 B 1/5 → 12칸 5/5, 그래서 12; 30 으로 되돌리려면 farDist 60 · boundEndDist 30) (수류탄 거리 × rushStandFrac). liftDist 안이면 포격을 creepLead 칸 너머로 (이동 탄막).
  // 3 돌파: 수류탄 volleys 번 (volleyGapSec 간격) → fuseWaitSec 뒤 착검 돌격 chargeThrough 칸 너머까지. enterFrac 이 참호에 들어가면 (또는 breakMaxSec) 다음.
  // 4 소탕: 양 끝으로 참호를 따라 쓸기, 경기관총은 양 끝 (endHoldBack 안쪽). 보이는 적이 clearConfirmSec 없으면 (또는 clearMaxSec) 다음. 5 확보: 공격 방향을 향해 점유 (holdPad · coverMaxHit), consolidateSec.
  // smokeHook · wireCutHook = 참호 돌파 묶음 (N59 연막 · 철조망 절단) 자리 (이 묶음에서는 안 씀). ai* = 전술 AI (공격 과제 소총 중대, 프로필 tactics.trenchAssault 로 켜고 끔).
  "trenchAssault": {
    "enabled": true, "decideSec": 0.5, "snapRadius": 6, "minMen": 6,
    "farDist": 40, "gunStandFrac": 0.85, "prepMinSec": 8, "prepMaxSec": 45, "suppGoal": 0.35, "suppFrac": 0.5, "suppRadius": 12, "stageMaxSec": 150,
    "useGroundFire": true, "aiGroundFire": false, "creepLead": 10, "liftDist": 14,
    "boundLength": 6, "boundMaxSec": 10, "boundEndDist": 12, "coverSearch": 3, "rushStandFrac": 0.8, "approachMaxSec": 150, "breakFrac": 0.5,
    "volleys": 2, "volleyGapSec": 1.2, "fuseWaitSec": 2, "chargeThrough": 3, "breakMaxSec": 25, "enterFrac": 0.4,
    "clearMaxSec": 60, "clearConfirmSec": 3, "clearRadius": 2.5, "endHoldBack": 1.5,
    "holdPad": 3, "consolidateSec": 15, "coverMaxHit": 0.9,
    "maxTotalSec": 420, "cooldownSec": 60, "spanRadius": 45,
    "aiEnabled": true, "aiTriggerDist": 70, "aiMinDist": 10, "aiMinDefenders": 3, "aiMinMen": 20, "aiMinOdds": 0.8,
    "smokeHook": false, "wireCutHook": false
  },
  // 도하 · 병목 돌파 (사용자 결정 2026-10-19, src/AI/Tactical/TacticalAi.Crossing.cs, docs/ENGINE_NOTES.md '도하 · 병목 돌파'). 밸런스 수치 아님 — AI 판단만. 칸 = 지도 칸.
  // 연대 앞 중대 → 적 직선이 두께 minObstacle~maxObstacle 칸의 못 걷는 띠 (강) 를 지나고, 그 띠가 옆으로 minBarrier 칸 이상 이어지며, searchLateral 칸 안에 폭 maxLaneWidth 이하의
  // 건널 곳이 있고 secondLaneRange 안에 다른 건널 곳이 없으면 (twoLanes false) 계획: 1 화력 기반 (모든 중대 = 강둑 칸 (fireBaseBack · bankWidth · bankMaxLateral · bankRowGap,
  // 반응 거리 안 적 맞은편, reslotSec 에 한 번 다시), 바깥 fireBaseFrac = 마지막에 건넘, 기관총 = 입구 좌우, 포병 = 출구 둘레) → fireMinSec 뒤 화력전 진척 (출구 둘레 보이는 적 progressDrop 감소)
  // 이 stallSec 동안 없거나 적 × launchOdds ≤ 도하 병력이면 (단 전체 소총 병력 ≥ 그 적 × minOdds 일 때만, 아니면 강둑에서 계속 사격) (포병은 준비사격 뒤 · prepWaitSec, 상한 fireMaxSec) 2 도하 (launchMinSec 간격 거의 동시 속보, commitSec 후퇴 미룸)
  // → 3 교두보 (도하 병력 bridgeheadFrac 이 출구 선 넘음, 칸 = 출구 앞 bridgeheadDepth · 폭 bridgeheadWidth, 최대 bridgeheadMaxSec) → bridgeheadHoldSec → 4 보통 공격 (진지는 출구 선 farSideMargin 앞).
  "crossing": {
    "enabled": true,
    "minObstacle": 3, "maxObstacle": 24, "minBarrier": 16, "searchLateral": 48, "maxLaneWidth": 10, "secondLaneRange": 60, "twoLanes": false,
    "triggerRange": 1.5, "checkSec": 4,
    "fireBaseFrac": 0.34, "fireBaseBack": 1, "bankWidth": 22, "bankMaxLateral": 42, "bankRowGap": 6, "reslotSec": 6,
    "fireMinSec": 15, "fireMaxSec": 300, "prepWaitSec": 20, "progressDrop": 0.05, "stallSec": 30, "launchOdds": 3, "minOdds": 2.5,
