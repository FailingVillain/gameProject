{
  // 역할군 · 중대 전술 틀 (1단계 배정 + 정지 배치, 2단계 행동 · 전환 — docs/TACTICAL_AI_STAGE3_PLAN.md '전술 대형 (역할군) 결정'). 코드: src/Core/CombatFormations.cs · TacticDrill.cs.
  // 역할: fire = 화력조 · rifle = 사격조 · manoeuvre = 기동조 · support = 지원 · command = 지휘 · 정찰.
  // 위치: x = 전선 폭 배수 (-0.5 = 왼쪽 끝, +0.5 = 오른쪽 끝; 폭 = 우클릭 드래그 폭, 없으면 2열 횡대 폭), y = 종심 단위 (depthUnit 칸) 배수, + 앞 · - 뒤.
  // 역할군 안에서는 분대째로 squadGap 칸 간격으로 나란히 — 같은 줄 (종심 차 ≤ 0.5) 역할군끼리 병력 비율로 전선 폭을 나눠 갖고, 몫보다 넓으면 분대 블록을 여러 줄로 접는다.
  // 그래도 겹치면 groupGap 칸 띄워 덜 움직이는 쪽 (옆, 또는 옆으로 폭의 ¼ 넘게 밀어야 하면 뒤) 으로 민다.
  // squadForm = 그 역할 분대의 기본 대형 (분대에 따로 정한 대형이 있으면 그것). stance = 기본 태세 hold · fire · advance (표시).
  // act = 2단계 행동 (src/Core/TacticDrill.cs, 중대 지휘관이 판단 — 접촉하면 실행):
  //   hold = 서서 사격 · 제압 (기관총 거치) · bound = 분대 교대 약진 (한 분대 전진, 나머지 사격) · manoeuvre = 엄폐를 따라 angle/standoff 위치로 가서 적이 제압됐거나 가까우면 돌격
  //   follow = 앞 역할군 뒤를 공격 이동 · support = 위협 (전차 · 기관총 · 장교) 우선 사격 · command = 화력조 뒤에 머묾 · trench = 가까운 참호 자리 점유 · reserve = 예비 (전선이 밀리면 역습)
  //   angle = 적 기준 접근 각도 (도, 0 = 정면, + = 오른쪽, 좌우 대칭 틀은 부호 반대), standoff = 적과의 거리 (주무기 사거리 배수), chargeRange = 돌격 개시 거리 (0 = behaviour.chargeRange),
  //   flanks = 0 보다 크면 그 역할 분대를 좌우 두 덩어리로 (±flanks × 전선 폭), wait = bound · manoeuvre 가 화력 우세 (behaviour.superiority*) 를 기다림 (기본 true).
  "depthUnit": 6,
  "groupGap": 2,
  "squadGap": 1.5,
  "roles": {
    // 자동 배정: 장교 = officer, 정찰병 = scout, 무기 키 → byWeapon, 병과 → byCategory, 그 밖 = default.
    "officer": "command",
    "scout": "command",
    "byWeapon": { "lmg": "fire", "lmg_chauchat": "fire", "hmg": "fire", "hmg_type3": "fire", "carbine_assault": "manoeuvre", "at_rifle": "support", "sniper_rifle": "support" },
    "byCategory": { "gun": "support", "armored": "fire" },
    "default": "rifle",
    // 기관총 한 정마다 같은 분대 소총수 loadersPerGun 명 (Id 순) 을 화력조 (탄약수) 로.
    "loadersPerGun": 1,
    // 소총 분대 (분대 번호 순) 가 minRifleSquads 개 이상이면 뒤쪽 ceil(분대 수 × manoeuvreFrac) 분대의 소총수 = 기동조 (착검 돌격).
    "rifleSplit": { "manoeuvreFrac": 0.34, "minRifleSquads": 3 }
  },
  // 2단계 행동 · 전환 수치. 판단 = 중대 지휘관 (장교 = 모든 틀, 부사관 대리 = 화력-기동만, 지휘 없음 = 틀 없음, 인계 중 = 판단 멈춤),
  // 판단 간격 decideTicks 틱 × 지휘관 경험치 배수 (officers.xpDecidePerLevel).
  "behaviour": {
    "decideTicks": 30,
    "contactSec": 1.5,        // 구성원이 표적을 잡았거나 이 초 안에 쐈으면 접촉
    "disengageSec": 10,       // 접촉이 이만큼 끊기면 행동 끝 (중대 대형으로 다시 정렬)
    "boundLength": 6,         // 사격조 한 번 약진 거리 (칸)
    "boundMaxSec": 10,        // 약진 분대가 이 초 안에 못 닿으면 그 자리에서 교대
    "rifleStopFrac": 0.55,    // 사격조는 적과 사거리 × 이 값까지만 다가감
    "boundSuppression": 0.6,  // 중대 평균 제압이 이 이상이면 약진 멈춤 (전원 사격)
    "boundCoverGain": 0.3,    // 화력 우세 (적 제압) 없이 약진하려면 약진 목표의 엄폐 점수가 지금보다 이만큼 높아야 (개활지 약진 금지)
    "coverSearch": 3,         // 이동 목표 둘레 엄폐 칸 찾는 반경 (칸)
    "manoeuvreCover": 0.5,    // 기동조 우회 목표 · 경유점의 엄폐 점수 하한 (지형 명중 배수 · 고지 — 숲 · 가옥 · 참호 · 고지 ≈ 0.6~1.4, 풀밭 0)
    "manoeuvreOpenSupp": 0.8, // 엄폐 없는 우회는 적 평균 제압이 이 이상일 때만
    "chargeRange": 6,         // 기동조 돌격 개시 거리 (적이 가까우면 무조건)
    "chargeSuppression": 0.4, // 표적 둘레 적 평균 제압이 이 이상이면 chargeMaxDist 안에서 돌격
    "chargeMaxDist": 12,
    "chargeOdds": 1.6,        // 또는 기동조 돌격 가능 인원이 적 (표적 둘레 chargeStatsRadius) 의 이 배 이상이면 돌격 (둘레 chargeMgRadius 에 쏘는 기관총이 없을 때)
    "chargeStatsRadius": 10,
    "chargeMgRadius": 8,
    "replanDist": 5,          // 자리 잡은 기동조: 적과의 거리가 standoff + 이 값을 넘으면 (적이 옮김) 새 위치로
    "chargeSec": 12,          // 돌격을 이 초 넘게 끌면 그 자리에서 사수
    "liftDist": 8,            // 기동조가 적에게 이만큼 다가가면 화력조 · 지원 · 사격조는 그 둘레 (liftRadius) 를 쏘지 않음 (연신)
    "liftRadius": 5,
    "counterRange": 6,        // 종심 방어 예비: 사격조 둘레 이 거리 안 적이 counterMin 명 이상이면 역습
    "counterMin": 3,
    "trenchSeek": 6,          // 참호 자리 찾는 반경 (칸)
    "commandBack": 4,         // 지휘 · 정찰은 화력조 뒤 이만큼에, commandSlack 넘게 떨어지면 다시 감
    "commandSlack": 5,
    "followFrac": 0.35,       // follow: 적과 사거리 × 이 값까지 공격 이동
    // 화력 우세 (wait = true 인 bound · manoeuvre 는 이것을 얻을 때까지 그 자리에서 사격): 중대 둘레 (사거리 + superiorityRadius) 의 보이는 적이
    // 평균 제압 ≥ superioritySupp, 또는 (적이 superiorityFew 이하일 때) 중대 병력 ≥ 적 수 × superiorityOdds. 사격조 약진은 교전이 patienceSec 넘게 이어져도
    "superioritySupp": 0.30,   // N25 제압 재설계 (2026-10-19): 0.20 → 0.30 (근접 탄착 · 느린 감소로 적 평균 제압이 올라 0.20 은 교전 중대-초 38% 우세) · N17: 0.55 → 0.20
    "superiorityOdds": 2.0,
    "superiorityRadius": 4,
    "superiorityFew": 0,       // 수 우세 규칙은 보이는 적이 이 수 이하이고 교전이 superiorityDelaySec 넘었을 때만 (안개 속 첫 접촉은 일부만 보임)
    "superiorityDelaySec": 12,
    "patienceSec": 90,        // N17 (2026-10-19): 60 → 90 — 신호가 살아 있으니 타이머는 보조. (오래 버틴 사격전은 사격조 약진만 허용, 기동조 우회는 제압 · 수 우세가 있어야)
    "approachFrac": 0.85,     // 화력 우세 전 사격조가 적과 사거리 × 이 값보다 멀면 사거리 × engageFrac 까지 전체 공격 이동
    "engageFrac": 0.6,        // (참고용 — 전술 AI 프로필 engageFrac 과 맞춤, engage 2026-10-19 · tweak1 0.65 → 0.6)
    // 결정 4 (사용자 승인 2026-10-19): 공격 돌격 (기동조 돌격 · 전술 AI 중대 돌격) 허가 — 거리 · 제압 조건에 더해
    // 화력 우세 신호 (보이는 적 평균 제압 ≥ superioritySupp) 또는 엄호 확인 (돌격조 밖 아군 overwatchMin 명 이상이 최근 overwatchSec 초 안에 돌격 표적 둘레 overwatchRadius 칸 안을 쏨)
    // + 병력비 (돌격 인원 ≥ 표적 둘레 chargeStatsRadius 의 보이는 적 × assaultMinOdds). 없으면 교전 assaultFallbackSec 초 뒤에만 옛 조건으로 (예비 타이머 — 옛 사실상 인내 타이머 90초보다 길게).
    // 행진 사격 → 돌격 전환 (N47, marchChargeRange 5칸) 도 이 허가를 받는다 — 예비 타이머 시작 = marchChargeSince ("phase" = 중대 전술 틀 국면 틱, 국면 없으면 공격 이동 명령 틱 · "order" = 늘 명령 틱).
    // 장교 자동 돌격 · 방어 역습은 그대로. assaultGate false = 옛 동작.
    "assaultGate": true,
    "assaultMinOdds": 1.0,
    "overwatchSec": 4,
    "overwatchRadius": 8,
    "overwatchMin": 3,
    "assaultFallbackSec": 150,
    "marchChargeSince": "phase"
  },
  // 결정 12 (2026-10-19): 전술 AI 대대 역할 — 소총 중대 병력이 minStrength 미만인 대대 (1명 분견대 · 전문 병과만) 는 화력 기반 · 기동 대대로 뽑지 않는다.
  // 전투 대대가 하나뿐이면 그 대대 안에서 중대를 화력 기반 · 기동으로 나눈다.
  "battalionRoles": { "minStrength": 40 },
  // 추격 · 후퇴 (사용자 결정 2026-10-19, src/Core/Pursuit.cs). 후퇴 = 속보 (가능한 병사) + 후퇴 표시 (도착 · 새 명령까지).
  // noChargeFleeing = 보병은 후퇴하는 적에게 착검 · 자동 · 행진 사격 5칸 · 장교 돌격을 걸지 않고 사격만. cavalryChargeFleeing = 기병 추격 돌격 허용 (전통적 기병 추격, 기본 true — 소규모 기병 규칙은 그대로).
  // 전술 AI 사격 추격: 표적 둘레 fleeingRadius 칸 적의 fleeingShare 이상이 후퇴 중이면 사거리 × rangeFrac 로 따라가며 쏨 (공격 이동),
  // 추격 시작 위치에서 maxDist × 소총 사거리 또는 maxSec 초를 넘으면 멈춰 regroupSec 초 제자리 사수 · 재정비. enabled false = 옛 동작 (보통 교전).
  // 후퇴 사격 (pursuit2): retreatFire = 후퇴 중 병사가 걸으며 사거리 (무기 사거리 × retreatFireRangeFrac, 근거리 시야 상한) 안 적을 쏨 — 명중 × retreatFireAccMul, 간격 × retreatFireIntervalMul. 멈춤 · 돌아섬 · 돌격 없음.
  "pursuit": { "noChargeFleeing": true, "cavalryChargeFleeing": true, "enabled": true, "fleeingShare": 0.5, "fleeingRadius": 12, "rangeFrac": 0.75, "maxDist": 1.0, "maxSec": 40, "regroupSec": 20,
               "retreatFire": true, "retreatFireAccMul": 0.3, "retreatFireIntervalMul": 2.0, "retreatFireRangeFrac": 0.75 },
  // 후퇴 뒤 재정비 (pursuit2, 전술 AI 소총 중대 — Pursuit.cs RegroupDef): 스스로 후퇴 (15초) 가 끝나면 minSec 초 제자리 사수 · 재정비, 그 뒤 checkSec 초마다
  // 병력 ≥ rejoinStrength · 평균 제압 ≤ rejoinSupp · (표적 둘레 적 대비 병력 ≥ rejoinOdds 또는 지원 = 다른 공격 중대 supportMin 개가 그 적 둘레 supportRadius × 소총 사거리 안에서 교전) 이면 재전진,
  // 증원 (+reinforceFrac × 처음 병력) 이면 제압만 보고 재전진, 접촉 거리 안 적이 없으면 재전진. 아니면 그 자리 사수 (지원 사격). enabled false = 옛 동작 (곧바로 재전진).
  // T31a noRejoinBelow (0 = 끔): 재정비 중 병력 < 처음 × 이 값이면 재전진 안 함 (그 자리 사수 = 예비 대용, 새 저장 필드 없음). 측정 켬 값 후보: rejoinStrength 0.7 + noRejoinBelow 0.5.
  "regroup": { "enabled": true, "minSec": 20, "checkSec": 5, "rejoinStrength": 0.5, "noRejoinBelow": 0, "rejoinSupp": 0.2, "rejoinOdds": 1.0, "reinforceFrac": 0.15, "supportRadius": 1.2, "supportMin": 1 },
  // 기병 (전술 AI CavalryThink): 돌격 = 기수 ≥ minRiders 그리고 기수 ≥ 표적 둘레 oddsRadius 칸 보이는 적 × minOdds (측면 · 후방 접근이면 × flankOddsMul). 아니면 정찰 · 차장 (카빈 사격 · 대기 · 물러남).
  // 접근 각 = 표적 무리 평균 방향 기준: frontDeg 안 = 정면 (점수 −frontPenalty, 표적 제압 ≥ frontSuppOk · 기수 ≥ 둘레 weakRadius 칸 적 × frontWeakOdds · 대형 흐트러짐 (방향 정렬도 < formedAlign) 일 때만 바로 돌격),
  // 그 밖 정면 표적은 옆 · 뒤 flankOffset 칸 (wayOutsideRange = 적 사거리 + 2 칸 밖) 경유점 (기관총 정면 사계 · mgAvoidRadius 칸 밖) 으로 돌아 들어간 뒤 돌격. 측면 flankScore · 후방 rearScore.
  // flankMinSupp (pursuit2) = 후퇴하지 않는 보병 묶음 (형성된 측면 · 후방 · 걷는 대형 · 흐트러진 대형) 을 돌격 표적으로 보려면 평균 제압 ≥ 이 값 (N22 = 0 → 소총 30 대 기병 30 역전, 사용자 결정으로 조금 엄격히) — 걷는 대형 · 수로만 약한 정면에도 같은 문턱. formedMinN = 묶음에 보이는 적이 이 수 미만이면 방향만으로 흐트러졌다고 보지 않음 (안개 속 몇 명).
  // 돌격할 곳 없이 적 사거리 + 6칸 안에 stallSec 초 넘게 머물면 적 사거리 + screenGap 칸 밖으로 물러나 차장 (N18 기관총 앞 교착 방지). 경유점 도착 wayReach 칸 · 최대 waySec 초.
  "cavalry": { "minRiders": 10, "minOdds": 2.0, "flankOddsMul": 0.7, "flankMinSupp": 0.3, "formedMinN": 4, "oddsRadius": 6, "frontDeg": 60, "flankScore": 0.6, "rearScore": 0.8, "frontPenalty": 1.0, "frontSuppOk": 0.5, "frontWeakOdds": 3, "weakRadius": 15, "formedAlign": 0.6, "flankOffset": 14, "wayOutsideRange": true, "mgAvoidRadius": 26, "stallSec": 20, "screenGap": 10, "wayReach": 4, "waySec": 25, "officerBack": 15,
    "strictCharge": true, "autoMinTargetSupp": 0.5, "isolatedMax": 3, "isolatedRadius": 6, "crewGuardRadius": 6, "autoFrontDeg": 60, "autoMaxOwnSupp": 250, "rechargeCooldownSec": 120 },   // officerBack (cavcmd): AI 기병 돌격 때 기병 장교는 표적 앞 이 칸에서 따라감 (지휘 유지, 0 = 함께 돌격)
  "templates": {
    "fire_manoeuvre": {
      "groups": {
        "fire":      { "x": -0.3,  "y": 0,    "stance": "fire",    "squadForm": "line",   "act": "hold" },
        "rifle":     { "x": 0.0,   "y": 0,    "stance": "fire",    "squadForm": "line",   "act": "bound" },
        "manoeuvre": { "x": 0.45,  "y": 0.6,  "stance": "advance", "squadForm": "wedge",  "act": "manoeuvre", "angle": 35, "standoff": 0.45 },
        "support":   { "x": -0.3,  "y": -0.8, "stance": "fire",    "squadForm": "line",   "act": "support" },
        "command":   { "x": 0.0,   "y": -1.0, "stance": "hold",    "squadForm": "close",  "act": "command" }
      }
    },
    "flank_left": {
      "groups": {
        "fire":      { "x": 0.1,   "y": 0,    "stance": "fire",    "squadForm": "line",   "act": "hold" },
        "rifle":     { "x": 0.35,  "y": 0,    "stance": "fire",    "squadForm": "line",   "act": "hold" },
        "manoeuvre": { "x": -0.8,  "y": 0.9,  "stance": "advance", "squadForm": "column", "act": "manoeuvre", "angle": -80, "standoff": 0.45 },
        "support":   { "x": 0.2,   "y": -0.8, "stance": "fire",    "squadForm": "line",   "act": "support" },
        "command":   { "x": -0.25, "y": -0.6, "stance": "hold",    "squadForm": "close",  "act": "command" }
      }
    },
    // 좌우 대칭 (x · angle 부호만 바꿈)
    "flank_right": { "mirror": "flank_left" },
    "defence_depth": {
      "groups": {
        "rifle":     { "x": 0.0,   "y": 0,    "stance": "hold",    "squadForm": "open",   "act": "trench" },
        "fire":      { "x": 0.0,   "y": -0.3, "stance": "fire",    "squadForm": "line",   "act": "hold", "flanks": 0.45 },
        "support":   { "x": -0.35, "y": -1.0, "stance": "fire",    "squadForm": "line",   "act": "support" },
        "command":   { "x": 0.3,   "y": -1.2, "stance": "hold",    "squadForm": "close",  "act": "command" },
        "manoeuvre": { "x": 0.0,   "y": -2.0, "stance": "hold",    "squadForm": "close",  "act": "reserve" }
      }
    },
    // 포병 대형 (이동): 역할군 대신 분대마다 작은 종대를 나란히 (formations.json "artillery"), 접촉하면 deployTactic 틀로 전개 (지휘가 허용하지 않으면 횡대).
    "artillery": { "layout": "squadColumns", "stance": "advance", "deployTactic": "fire_manoeuvre" },
    "assault": {
      "groups": {
        "manoeuvre": { "x": 0.0,   "y": 0.6,  "stance": "advance", "squadForm": "line",   "act": "manoeuvre", "angle": 0, "standoff": 0.15, "chargeRange": 9, "wait": false },
        "rifle":     { "x": 0.0,   "y": 0,    "stance": "advance", "squadForm": "line",   "act": "follow" },
        "fire":      { "x": -0.45, "y": -0.2, "stance": "fire",    "squadForm": "line",   "act": "hold" },
        "support":   { "x": 0.45,  "y": -0.4, "stance": "fire",    "squadForm": "line",   "act": "support" },
        "command":   { "x": 0.0,   "y": -0.7, "stance": "advance", "squadForm": "close",  "act": "command" }
      }
