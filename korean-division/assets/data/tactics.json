    "bridgeheadDepth": 7, "bridgeheadWidth": 14, "bridgeheadFrac": 0.6, "bridgeheadMaxSec": 70, "bridgeheadHoldSec": 0,
    "farSideMargin": 1
  },
  // 역습 교리 (사용자 결정 2026-10-19, src/AI/Tactical/TacticalAi.Counter.cs): 미션 posture "counter" · 방어 그룹의 세력 반격. 밸런스 수치 아님.
  // 접촉 → (commitReserves) 예비 투입 · 1 고정 사격 fixMinSec ~ fixMaxSec (표적 둘레 적 평균 제압 ≥ assaultSupp 이면 일찍) → 연대 앞 병력 ≥ 보이는 적 × minOdds 이면
  // 2 일제 돌격: 화력 기반 (fireBaseFrac) 을 뺀 전 중대가 돌격 거리 × closeFrac 까지 속보 → 착검 돌격 (조건 chargeSuppression · chargeOdds, 돌격 허가 예비 타이머 assaultFallbackSec,
  // noRetreatSec 동안 스스로 후퇴 미룸) → assaultMaxSec 뒤 (또는 돌격 중대 전원 후퇴) 다시 1.
  "counter": {
    "enabled": true, "commitReserves": true,
    "fixMinSec": 15, "fixMaxSec": 35, "assaultSupp": 0.15, "minOdds": 1.2,
    "closeFrac": 0.85, "chargeSuppression": 0.2, "chargeOdds": 1.0, "assaultFallbackSec": 15,
    "noRetreatSec": 25, "assaultMaxSec": 45, "fireBaseFrac": 0.34
  },
  // 포병 AI 문턱 (N20 2026-10-19, src/AI/Tactical/TacticalAi.Artillery.cs). 밸런스 수치 아님 — AI 판단만. 칸 단위는 지도 ×1.5 이후 칸.
  "artilleryAi": {
    "observerAhead": 8,          // 관측자 (관측반 · AI 가 부리는 정찰병): 아군 보병 앞선보다 이 칸 앞 (엄폐 · 고지 둘레 observerCoverRadius 칸)
    "observerContactBack": 4,    // 접촉 뒤 (지점 둘레에 보이는 적) 관측자 지점 = 아군 전선 (중대 무게중심 앞선) 에서 이 칸 뒤
    "observerStandoff": 1.5,     // 보이는 적과 최소 거리 = 소총 사거리 × 이 값 (적 소총 · 저격총 사거리 밖, 돌격을 이끌지 않음)
    "observerCoverRadius": 3,
    "observerRepost": 6,         // 관측 지점이 이 칸 넘게 바뀌어야 다시 보냄
    "observerSec": 2,            // 판단 간격 (초)
    "observerAvoidSec": 120, "observerAvoidRadius": 8, "observerAvoidStandoff": 4, "observerAvoidSearch": 10,   // tweak1: 노려져 엄폐한 관측자는 120초 동안 그 노출 지점 8칸 안 · 그때 사격자에게 (노출 거리 + 4) 칸보다 가까운 곳으로 다시 보내지 않음 — 둘레 10칸의 엄폐 · 은폐 · 사선 밖 칸으로
    "observerRetask": 2,         // 관측자 전멸 + 관측 표적 10초 없음 → 소총 중대 정찰조에서 이 수만큼 새 관측반 (곡사포가 있을 때만, 0 = 안 함)
    "supportRadius": 12,         // 곡사포: 아군 돌격 > 기동조 > 약진 표적 둘레 이 칸 안의 적 우선
    "dangerClose": 5,            // 강제 표적은 아군에서 dangerClose + dangerScatterMul × (그 거리 퍼짐) 칸 밖
    "dangerScatterMul": 0.75,
    "redeployCooldownSec": 60,   // 포대 재배치 쿨다운 (방열 뒤), × max(1, 포대 수 / redeployBatteryRef) (N22 측정: 30 → 20)
    "redeployBatteryRef": 4,
    "redeployMinMove": 10,       // 이보다 작은 진지 수정은 하지 않음 (제자리 선회 N10)
    "redeployRangeFrac": 0.75,   // (N22 측정: 0.85 → 0.75) 곡사포는 표적이 사거리 × 이 값 밖이면 전진 (쿨다운 뒤 · 쏘는 중이면 표적 지역이 사거리 0.92 밖일 때만)
    "redeployWantFrac": 0.65,    // 옮길 때 표적과의 거리 = 사거리 × 이 값 (한 번에 깊이 — 옛 0.75)
    "gunIdleSec": 20,            // 이 초 안에 (직사포는 유효 사거리 안 표적을) 쏜 포가 있는 포대는 옮기지 않음 (곡사포 재장전 14~17초 포함)
    "gunEffectiveFrac": 0.8,     // 직사포 유효 사거리 비율 — 먼 표적은 가까운 표적이 있으면 버림, 가장 가까운 적이 이보다 멀면 진지 이동
    "gunStandoffFrac": 0.65,     // 직사포 사격 진지 = max(사거리 × 이 값, 소총 사거리 × gunStandoffRifleMul) (유효 사거리 이하)
    "gunStandoffRifleMul": 1.3,
    "gunDeployLead": 1.5,        // 직사포 전개 시작: 보이는 적이 사거리 + 소총 사거리 × 이 값 안 (옛 1.0)
    // N22 보병포 (사거리 closeGunMaxRange 이하 직사포 = 대대와 함께 움직이는 근접 지원포): 지원 중대 무게중심 closeGunFollow 칸 뒤를 따라가다,
    // 접촉 (보이는 적이 중대에서 사거리 + 소총 사거리 × closeGunContactLead 안) 하면 중대 무게중심에서 적 반대쪽 closeGunBehind 칸 (가장 가까운 적이 유효 사거리 − 2 안, 아군 보병 앞선 1칸 뒤 상한) 에 방열.
    // 표적 점수 = 기관총 closeGunMgW + 포 closeGunGunW + 엄폐한 적 closeGunCoverW + 둘레 2칸 적마다 closeGunClusterW − 거리 × closeGunDistW (closeGunRetargetSec 마다, closeGunKeep 점 넘게 좋아야 바꿈)
    "closeGunMaxRange": 50, "closeGunBehind": 3, "closeGunFollow": 8, "closeGunContactLead": 1.0,
    "closeGunMove": 10, "closeGunCooldownSec": 20, "closeGunIdleSec": 8,
    "closeGunMgW": 30, "closeGunGunW": 20, "closeGunCoverW": 12, "closeGunClusterW": 4, "closeGunDistW": 0.5, "closeGunKeep": 10, "closeGunRetargetSec": 4
  }
