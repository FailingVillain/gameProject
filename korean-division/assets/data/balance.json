    "force": [
      { "units": { "officer": 1, "infantry": 24, "infantry_scout": 2 }, "company": true, "battalion": 1 },
      { "units": { "officer": 1, "infantry": 24, "infantry_scout": 2 }, "company": true, "battalion": 1 },
      { "units": { "officer": 1, "heavy_machinegunner": 4, "heavy_at_rifleman": 4, "infantry_scout": 2 }, "company": true, "battalion": 1 },
      { "units": { "tank_ft_male": 2, "tank_ft_female": 1 } },
      { "units": { "supply_wagon": 2 } }
    ]
  },
  // 탄약 회복: 마지막 사격 · 피격(빗나감 포함) 뒤 regenDelay 초가 지나면 한도의 regenPct/초 (interval 초마다 판정, 유닛 Id 로 분산).
  // 자기 · 동맹 도시(city) 가장자리 cityRadius 칸 안 ×cityMul, 보급 마차 wagonRadius 칸 안 ×wagonMul (중첩 없음, 큰 쪽). 차량 · 포도 같은 규칙 (연료 없음)
  "supply": {
    "regenDelay": 30, "regenPct": 0.0015, "interval": 1.0,
