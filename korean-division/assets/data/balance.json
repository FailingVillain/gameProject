    "wireMove": 0.3,            // 철조망 = 통과 불가 장애물 (임시, 2026-10-19; 아래 이동 · 멈칫 값은 현재 쓰이지 않음, 되돌릴 때용): 이동 ×0.3 + 1초마다 35% 확률로 0.3~0.8초 멈칫 (장갑 차량 제외)
    "wireHesitateChance": 0.35, "wireHesitateMin": 0.3, "wireHesitateMax": 0.8, "wireHesitateInterval": 1.0,
    "trenchMove": 1.0, "trenchHit": 0.5, "trenchSuppress": 0.5,   // 참호 지형 (지도 · 미션에 그려진 참호선만 — 건설 제거 2026-10-19). 명중 배수 0.6 → 0.5 (tweak1 2026-10-19 사용자 결정 — 방어 우위 회복), trenchPerTile 2 그대로
    // 참호 자동 점유: 이동 중 참호 칸을 밟은 보병은 trenchCaptureRadius 칸 안의 빈 자리에 들어가 사수, 이동 명령의 대형 슬롯은 trenchSnapRadius 칸 안의 빈 자리로 붙는다. 칸당 trenchPerTile 명
    "trenchPerTile": 2, "trenchSnapRadius": 2.0, "trenchCaptureRadius": 1.5,
    "craterMove": 0.85, "craterHit": 0.8, "craterSuppress": 0.8,  // 포탄 구덩이 (포격 착탄으로 생김, 무기 craterChance)
    "highSightMul": 1.25,       // 고지: 시야 +25%
    "highToLowHit": 1.15, "lowToHighHit": 0.85,   // 고지 → 평지 사격 명중 ×1.15, 반대 ×0.85
    "slopeMove": 0.8            // 경사 (평지와 맞닿은 고지 칸) 이동 ×0.8
