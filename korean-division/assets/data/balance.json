  },
  // 지형 (ROADMAP '지형 · 높이', 2026-10-19): 이동 ×, 엄폐 = 맞을 확률 × · 받는 제압 × (지형 · 가옥 옆 중 가장 좋은 값 하나, 겹치지 않음)
  "terrain": {
    "forestMove": 0.7, "forestHit": 0.8, "forestSuppress": 0.85,   // forest 2026-10-19: 맞을 확률 0.7 → 0.8, 제압 0.8 → 0.85 (은폐 약화, 측정 후 결정)
    "forestSeeDepth": 3,        // 숲 가장자리에서 3칸 깊이까지만 보이고 쏠 수 있다 (forest 2026-10-19: 2 → 3, 교착 완화). 더 깊은 숲은 시야 · 사선을 막는다
    "rubbleMove": 0.6, "rubbleHit": 0.5, "rubbleSuppress": 0.6,
